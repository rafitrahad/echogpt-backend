# Copy this file to .env and fill in real values. Never commit .env.

# ── App ──
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Asia/Dhaka
CORS_ORIGIN=*

# ── Database ──
DATABASE_URL=postgresql://postgres:password@localhost:5432/echogpt
DB_LOGGING=false

# ── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption: exactly 64 hex chars (generate with randomBytes(32)) ──
ENCRYPTION_KEY=change-me-64-hex-chars

# ── First admin (created by the seed script) ──
ADMIN_EMAIL=admin@echogpt.local
ADMIN_PASSWORD=change-me

# ── Rate limiting ──
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ── Search ──
SEARCH_CACHE_TTL_SECONDS=3600

# ── AI ──
AI_MOCK_MODE=true

# ── Web search: wikipedia (free, no key) | tavily (needs TAVILY_API_KEY) | mock ──
SEARCH_PROVIDER=wikipedia
TAVILY_API_KEY=